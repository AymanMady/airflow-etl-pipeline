# =============================================================================
#  ecommerce-etl - environment variables
# =============================================================================
#  Copy this file to .env then adjust the values:
#      cp .env.example .env
#
#  .env holds the real secrets: it is in .gitignore and NEVER committed.
#  .env.example is versioned: it documents the expected variables, with dummy
#  values. It is the project's configuration contract.
# =============================================================================

# -----------------------------------------------------------------------------
#  1. WAREHOUSE - the database holding the e-commerce data
# -----------------------------------------------------------------------------
#  HOST and PORT are the values as seen FROM INSIDE the Docker network.
#  "postgres-warehouse" is the service name in docker-compose.yml: Docker
#  resolves it to the container's IP address automatically.
POSTGRES_HOST=postgres-warehouse
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=changeme

#  Port published on YOUR machine to connect from outside (DBeaver, a local
#  psql, Adminer). 5435 avoids the other projects already running on
#  5432 / 5433 / 5434 / 5440.
WAREHOUSE_HOST_PORT=5435

# -----------------------------------------------------------------------------
#  2. METADATA DB - Airflow's internal database
# -----------------------------------------------------------------------------
#  Airflow stores its DAG runs, task instances, logs, users and connections
#  there. It is deliberately SEPARATE from the warehouse (see README,
#  section 3). It is not published on a host port: nothing outside needs to
#  reach it.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
#  3. AIRFLOW - arrives in PHASE 5
# -----------------------------------------------------------------------------
#  AIRFLOW_UID: the Unix UID the Airflow containers run as.
#  Without it, the files written into ./logs and ./data belong to root and you
#  can no longer read or delete them from your own account.
#  Get yours with:  id -u
AIRFLOW_UID=50000
AIRFLOW_WEB_PORT=8089

# -----------------------------------------------------------------------------
#  4. OPTIONAL TOOLS
# -----------------------------------------------------------------------------
#  Adminer: a web SQL client, started only with --profile tools
ADMINER_PORT=8083

# -----------------------------------------------------------------------------
#  5. AIRFLOW - security and administrator account
# -----------------------------------------------------------------------------
#  FERNET_KEY encrypts the Connection passwords in the metadata db.
#  Generate your own:
#    python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
#  Signing secret for the internal API tokens:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
